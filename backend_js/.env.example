# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Modelo de variáveis de ambiente
# O arquivo .env NUNCA deve ser enviado ao GitHub!
# ─────────────────────────────────────────────────────────────────────────────

# Banco de Dados MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=1234
DB_NAME=academic_atelier

# Modo de Simulação (Mock) — Ativa o login sem MySQL se definido como 'true'
USE_MOCK=false

# Chave secreta para geração dos tokens JWT
# Use uma string longa e aleatória (ex: abc123xyz789...)
JWT_SECRET=troque_por_uma_chave_secreta_longa_aqui

# Porta do servidor backend (padrão: 3001)
PORT=3001
